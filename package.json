{
  "name": "landslide-early-warning-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Based Early Warning and Landslide Risk Monitoring System (NER)",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "setup": "node ./scripts/cli.js --setup",
    "cli": "node ./scripts/cli.js",
    "dev": "./scripts/dev.sh",
    "dev:all": "./scripts/dev.sh",
    "dev:backend": "cd apps/backend && ../../.venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:web": "npm run dev --workspace=@landslide/web",
    "build:web": "npm run build --workspace=@landslide/web",
    "build": "npm run build --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "landslide",
    "early-warning",
    "monorepo",
    "npm",
    "nextjs",
    "flutter",
    "fastapi"
  ],
  "author": "",
  "license": "ISC"
}
