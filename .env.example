# ==============================================================================
# Parvaah Monorepo Global Environment Configuration Template (.env.example)
# Copy this file to .env before starting the services:
#   cp .env.example .env
# ==============================================================================

# --- General System Configuration ---
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info
REGION_FOCUS=North Eastern Region (NER), India

# --- Backend API (FastAPI) ---
PORT=8000
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Parvaah - Landslide Early Warning System API"

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parvaah
POSTGRES_DB=parvaah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Web Dashboard Client (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_APP_NAME="Parvaah Landslide Risk Monitor"

# --- Mobile Client (Flutter) ---
MOBILE_API_BASE_URL=http://10.0.2.2:8000

# --- ML Engine & Model Artifacts ---
ML_ENGINE_PATH=apps/ml-engine
ML_MODEL_PATH=apps/ml-engine/models/fusion_risk/saved_models/fusion_risk_model.pkl
MODEL_VERSION=v1.0.0-fusion

# --- Alerting & Escalation Timeouts (minutes) ---
CRITICAL_ESCALATION_MINUTES=30
HIGH_ESCALATION_MINUTES=60
